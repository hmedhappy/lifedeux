# Copy to the project root as .env.production, then fill in every value marked CHANGE_ME.
#   cp deploy/.env.production.example .env.production

# --- Domain and reverse proxy ------------------------------------------------
DOMAIN=lifedeux.afdev.site
APP_URL=https://lifedeux.afdev.site
# 1 = Caddy handles HTTPS on ports 80/443 (simplest).
# 0 = you already run nginx on this VPS: use deploy/nginx-lifedeux.conf instead.
USE_CADDY=1
# Local port the app listens on (127.0.0.1 only), used by nginx when USE_CADDY=0.
APP_PORT=3010

# --- Secrets ------------------------------------------------------------------
# Generate each one with:  openssl rand -hex 24   (letters and digits only:
# the database password goes inside a URL, where / + = would break it)
POSTGRES_PASSWORD=CHANGE_ME
AUTH_SECRET=CHANGE_ME
CRON_SECRET=CHANGE_ME

# --- First admin account (created on first deploy) -----------------------------
ADMIN_EMAIL=CHANGE_ME@example.com
ADMIN_PASSWORD=CHANGE_ME

# --- Demo data: true = demo doctors, patients, stays and bookings (for testing) ---
# Set back to 0 before real patients use the site.
SEED_DEMO=false

# --- Payments ---------------------------------------------------------------------
# Keep "true" to test with the fake checkout until Stripe is configured.
PAYMENT_MOCK=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_API_URL=https://api.konnect.network/api/v2

# --- Emails (optional) --------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="LifeDeux <no-reply@afdev.site>"

# --- Google sign-in (optional; without it, patients sign in with an email code) ---
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- WhatsApp notifications (optional; without them, email only) ------------------
# Meta for Developers → WhatsApp → API setup. Create an approved message template
# named like WHATSAPP_TEMPLATE with ONE body variable {{1}}, in fr, en and ar.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=lifedeux_notification
