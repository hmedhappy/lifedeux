# --- Required ---------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lifedeux"
# Random secret, 32+ characters (e.g. `openssl rand -base64 48`)
AUTH_SECRET=""
# Public URL of the site, without trailing slash (used in emails, QR codes, payment redirects)
APP_URL="https://www.example.com"

# First admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# --- Payments (a provider is enabled as soon as its variables are set) ------
# Stripe — international cards
STRIPE_SECRET_KEY=""
# Webhook endpoint: {APP_URL}/api/webhooks/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=""

# Konnect — Tunisian cards / e-DINAR (optional)
KONNECT_API_KEY=""
KONNECT_WALLET_ID=""
# Sandbox: https://api.sandbox.konnect.network/api/v2 — Production: https://api.konnect.network/api/v2
KONNECT_API_URL="https://api.konnect.network/api/v2"

# Fake checkout for demos/tests only. Never "true" in production.
PAYMENT_MOCK="false"

# --- Emails (optional: without SMTP, emails are only logged) ---------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="LifeDeux <no-reply@example.com>"

# --- Scheduled job ----------------------------------------------------------
# GET /api/cron/expire with header "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=""

# --- Seed options -----------------------------------------------------------
# "true" adds demo doctors, stays, slots, an agent and a patient
SEED_DEMO="false"

# --- Google sign-in (optional) ---------------------------------------------
# Redirect URI to declare: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- WhatsApp Cloud API (optional; email is used without it) ---------------
# Approved template with one body variable {{1}}, in fr / en / ar.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_TEMPLATE="lifedeux_notification"
